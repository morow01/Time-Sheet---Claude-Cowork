rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/noteImages/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // File attachments on notes — the app already writes here
    // (_uploadNoteFile), but the path was never permitted, so those
    // uploads were being rejected.
    match /users/{userId}/noteFiles/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Full data backups. These live in Storage rather than Firestore
    // because Firestore caps a document at 1MB and the backup payload
    // outgrew that; Storage has no such limit.
    match /users/{userId}/backups/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
