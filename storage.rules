rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Everything a user owns lives under users/{userId}/ — noteImages,
    // noteFiles, backups. A single wildcard keeps this in step with the
    // app: new storage paths work without a rules deploy, and access is
    // still restricted to the owning account.
    //
    // Kept deliberately broad. An earlier version of this file listed only
    // noteImages, which did NOT match what was actually deployed — the
    // deployed rules have always been this wildcard. Narrowing it would
    // silently break any path not explicitly listed (noteFiles was already
    // in that position).
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
